//LICNIGHT JOB (LIC,PRD),'LICSYS NIGHTLY',CLASS=A,MSGCLASS=X
//*
//* LICSYS NIGHTLY BATCH. RUN AFTER OFFENCE FEED LANDS (APPROX 0130).
//* STEP ORDER MATTERS: LICUPG READS THE MASTER WRITTEN BY DMRPTS.
//*
//STEP010  EXEC PGM=DMRPTS
//DRVMAST  DD DSN=LIC.PRD.DRVMAST,DISP=SHR
//OFFENCE  DD DSN=LIC.PRD.OFFENCES.DAILY,DISP=SHR
//DRVPOST  DD DSN=LIC.PRD.DRVMAST.POSTED,DISP=(NEW,CATLG)
//POSTRPT  DD SYSOUT=*
//NOTICE   DD DSN=LIC.PRD.NOTICES,DISP=(NEW,CATLG)
//*
//STEP020  EXEC PGM=LICUPG,COND=(0,NE,STEP010)
//RUNDATE  DD DSN=LIC.PRD.RUNDATE,DISP=SHR
//DRVPOST  DD DSN=LIC.PRD.DRVMAST.POSTED,DISP=SHR
//DRVNEW   DD DSN=LIC.PRD.DRVMAST.NEW,DISP=(NEW,CATLG)
//UPGRPT   DD SYSOUT=*
//*
//STEP030  EXEC PGM=REGFEE
//VEHICLE  DD DSN=LIC.PRD.REGO.RENEWALS,DISP=SHR
//FEERPT   DD DSN=LIC.PRD.REGO.FEES,DISP=(NEW,CATLG)
